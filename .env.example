# ==============================================================================
# Fiuuuu
# ==============================================================================

# Core Application Settings
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api
LOG_LEVEL=info

# Exposed Host Ports (avoiding Windows Port 80 IIS/http.sys conflict)
APP_PORT=4000
HTTP_PORT=8080

# Database (PostgreSQL is the authoritative local runtime store)
DB_TYPE=postgres
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=bank_infosec_db
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_SSL=false

# Redis Distributed Cache & Session Store
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=aegissec:
REDIS_TTL_SECONDS=300

# RabbitMQ transactional-outbox delivery. The API does not publish domain
# events directly: the worker relays committed PostgreSQL outbox records.
RABBITMQ_ENABLED=false
RABBITMQ_URL=amqp://aegissec:replace-with-rabbitmq-password@localhost:5672/aegissec
RABBITMQ_EXCHANGE=aegissec.events
OUTBOX_RELAY_INTERVAL_MS=1000
OUTBOX_RELAY_BATCH_SIZE=50
SLA_SCHEDULER_INTERVAL_MS=60000

# Docker Compose infrastructure values. Set real secret values only through
# your approved deployment secret mechanism; do not commit a populated .env.
POSTGRES_USER=bank_admin
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=bank_infosec_db
REDIS_PASSWORD=replace-with-strong-redis-password
RABBITMQ_USER=aegissec
RABBITMQ_PASSWORD=replace-with-strong-rabbitmq-password
RABBITMQ_VHOST=aegissec

# Object Storage Service (AWS S3 or Local Disk - NO MinIO)
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./data/storage
S3_BUCKET=apex-bank-infosec-artifacts
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
MAX_UPLOAD_SIZE_BYTES=26214400
MALWARE_SCAN_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000

# Optional local-only Grafana listener, used with the observability profile.
GRAFANA_ADMIN_USER=aegissec-admin
GRAFANA_ADMIN_PASSWORD=replace-with-strong-grafana-password
GRAFANA_PORT=3000

# Security, Cryptography & Rate Limiting
JWT_SECRET=replace-with-a-unique-32-character-minimum-secret
# Generate and rotate separately from JWT_SECRET (for example via your KMS).
DATA_ENCRYPTION_KEY=replace-with-a-separate-32-character-minimum-secret
JWT_EXPIRES_IN=8h
SESSION_TIMEOUT_MINUTES=30
# Browser-restart persistence is capped server-side; idle sessions still expire.
SESSION_ABSOLUTE_TIMEOUT_HOURS=168
# Development-only: permits a blank password only for an existing active AD user.
DEV_EMPTY_PASSWORD_LOGIN_ENABLED=false
CORS_ORIGIN=*
TRUST_PROXY_HOPS=1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
AUTH_RATE_LIMIT_MAX=15

# Observability
ENABLE_METRICS=true

# Active Directory / LDAP (required for authentication and directory sync)
LDAP_ENABLED=false
LDAP_URL=
LDAP_BASE_DN=
LDAP_USER_SEARCH_BASE=
LDAP_DOMAIN=
LDAP_BIND_USER=
LDAP_BIND_PASSWORD=
LDAP_TLS_REJECT_UNAUTHORIZED=true
LDAP_SYNC_TIME_GMT4=13:30
LDAP_SYNC_TIMEZONE=Asia/Baku
LDAP_SYNC_AUTO_ENABLED=true
LDAP_SYNC_MIN_COVERAGE=0.5
