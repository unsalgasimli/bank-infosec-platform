# ==============================================================================
# Bank InfoSec Platform Environment Configuration
# ==============================================================================

# Core Application Settings
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api
LOG_LEVEL=info

# Exposed Host Ports (avoiding Windows Port 80 IIS/http.sys conflict)
APP_PORT=4000
HTTP_PORT=8080

# Database (PostgreSQL is the authoritative local runtime store)
DB_TYPE=postgres
DATABASE_URL=postgresql://bank_admin:BankSecureAdminPass2026!@localhost:5432/bank_infosec_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=bank_admin
DB_PASSWORD=BankSecureAdminPass2026!
DB_NAME=bank_infosec_db
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_SSL=false

# Redis Distributed Cache & Session Store
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=aegissec:
REDIS_TTL_SECONDS=300

# Object Storage Service (AWS S3 or Local Disk - NO MinIO)
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./data/storage
S3_BUCKET=apex-bank-infosec-artifacts
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
MAX_UPLOAD_SIZE_BYTES=26214400

# Security, Cryptography & Rate Limiting
JWT_SECRET=aegissec-enterprise-super-secret-jwt-key-2026
VCENTER_CREDENTIAL_KEK=BAbbBHvEWXgFQBII6Q5zrzXmJW5u60Lh8BT6ZdQLSUQ
JWT_EXPIRES_IN=8h
SESSION_TIMEOUT_MINUTES=10080
SESSION_ABSOLUTE_TIMEOUT_HOURS=168
DEV_EMPTY_PASSWORD_LOGIN_ENABLED=true
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=2000
AUTH_RATE_LIMIT_MAX=60

# Active Directory / LDAP Integration Settings
LDAP_ENABLED=true
LDAP_URL=ldaps://DC01.Expressbank.az:636
LDAP_BASE_DN=DC=Expressbank,DC=az
LDAP_DOMAIN=EXPRESSBANK.AZ
LDAP_SYNC_AUTO_ENABLED=false

# Observability
ENABLE_METRICS=true
