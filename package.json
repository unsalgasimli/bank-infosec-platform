{
  "name": "bank-infosec-platform",
  "version": "1.0.0",
  "description": "Enterprise Information Security & GRC Ticket Management Platform for Banking Operations",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "dev": "concurrently -n \"API,UI\" -c \"blue,green\" \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "pnpm run build:client && pnpm run build:server",
    "audit:css": "node scripts/audit-css.mjs",
    "lint:css": "node scripts/audit-css.mjs --check",
    "test": "tsx --import ./src/tests/setup.ts --test --test-concurrency=1 src/tests/**/*.test.ts",
    "sync": "tsx src/server/scripts/sync-ad-readonly.ts",
    "sync:ad": "tsx src/server/scripts/sync-ad-readonly.ts",
    "directory:grant-platform-access": "tsx src/server/scripts/grant-directory-platform-access.ts",
    "directory:reconcile-sections": "tsx src/server/scripts/reconcile-ad-section-projection.ts",
    "db:migrate": "tsx src/server/db/postgres/migrate.ts",
    "db:seed": "tsx src/server/db/postgres/seed-postgres.ts",
    "db:import-json": "tsx src/server/db/postgres/import-json.ts",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.6.0",
    "ldapts": "^9.0.0",
    "lucide-react": "^1.16.0",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "rate-limit-redis": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "pino-pretty": "^13.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
