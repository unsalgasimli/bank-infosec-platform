# ==============================================================================
# Apex Bank International - Production Environment Configuration Template
# Strictly Confidential - Banking Security Operations
# ==============================================================================

# Core Application
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api
LOG_LEVEL=info

# Production Database (PostgreSQL 16 High Availability Cluster)
DB_TYPE=postgres
DATABASE_URL=postgresql://bank_admin:REPLACE_WITH_STRONG_DB_PASSWORD@postgres:5432/bank_infosec_db?sslmode=require
DB_POOL_MIN=4
DB_POOL_MAX=25
DB_SSL=true

# Production Redis Cluster / Sentinel
REDIS_ENABLED=true
REDIS_URL=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@redis:6379
REDIS_KEY_PREFIX=aegissec:
REDIS_TTL_SECONDS=300

# Durable outbox/event transport. Store the full URL in the corporate secrets
# manager; it must target the private RabbitMQ vhost, never the public network.
RABBITMQ_ENABLED=true
RABBITMQ_URL=amqp://aegissec:REPLACE_WITH_RABBITMQ_PASSWORD@rabbitmq:5672/aegissec
RABBITMQ_EXCHANGE=aegissec.events
OUTBOX_RELAY_INTERVAL_MS=1000
OUTBOX_RELAY_BATCH_SIZE=50
SLA_SCHEDULER_INTERVAL_MS=60000

# Production Cloud Object Storage (AWS S3 with KMS Encryption)
STORAGE_PROVIDER=s3
S3_BUCKET=apex-bank-prod-infosec-evidence
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=REPLACE_WITH_IAM_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_IAM_SECRET_KEY
MAX_UPLOAD_SIZE_BYTES=26214400
MALWARE_SCAN_ENABLED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
GRAFANA_ADMIN_USER=aegissec-admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_GRAFANA_ADMIN_PASSWORD
GRAFANA_PORT=3000

# Security, Cryptography & Strict Banking Policies
JWT_SECRET=GENERATE_64_CHAR_CRYPTOGRAPHIC_RANDOM_SECRET_KEY
JWT_EXPIRES_IN=4h
SESSION_TIMEOUT_MINUTES=15
CORS_ORIGIN=http://infosec.apexbank.int
TRUST_PROXY_HOPS=1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=2000
AUTH_RATE_LIMIT_MAX=10

# Observability & Metrics
ENABLE_METRICS=true
